# ==============================================================================
# Suyog Textile — Apache Configuration (.htaccess)
# ==============================================================================

RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Friendly Category and Page Routing
RewriteRule ^sarees/?$ shop.html?cat=sarees [L,QSA]
RewriteRule ^salwar-suits/?$ shop.html?cat=salwar-suits [L,QSA]
RewriteRule ^lehengas/?$ shop.html?cat=lehengas [L,QSA]
RewriteRule ^kurtis/?$ shop.html?cat=kurtis [L,QSA]
RewriteRule ^dresses/?$ shop.html?cat=dresses [L,QSA]
RewriteRule ^mens-wear/?$ shop.html?cat=mens-wear [L,QSA]
RewriteRule ^catalog/?$ shop.html [L,QSA]
RewriteRule ^products/?$ shop.html [L,QSA]
RewriteRule ^new-arrivals/?$ shop.html [L,QSA]
RewriteRule ^offers/?$ offers.html [L,QSA]
RewriteRule ^studio/?$ studio.html [L,QSA]
RewriteRule ^wishlist/?$ wishlist.html [L,QSA]
RewriteRule ^cart/?$ cart.html [L,QSA]
RewriteRule ^checkout/?$ checkout.html [L,QSA]
RewriteRule ^order-success/?$ order-success.html [L,QSA]
RewriteRule ^order-confirmation/?$ order-success.html [L,QSA]
RewriteRule ^orders/([0-9]+)/invoice/?$ invoice.html?id=$1 [L,QSA]
RewriteRule ^orders/([0-9]+)/track/?$ order-detail.html?id=$1 [L,QSA]
RewriteRule ^orders/([0-9]+)/?$ order-detail.html?id=$1 [L,QSA]
RewriteRule ^orders/?$ orders.html [L,QSA]
RewriteRule ^invoice/?$ invoice.html [L,QSA]
RewriteRule ^login/?$ login.html [L,QSA]
RewriteRule ^register/?$ register.html [L,QSA]
RewriteRule ^account/?$ account.html [L,QSA]
RewriteRule ^admin/dashboard/?$ admin/index.html [L,QSA]
RewriteRule ^admin/products/new/?$ admin/product-form.html [L,QSA]
RewriteRule ^admin/products/([0-9]+)/edit/?$ admin/product-form.html?id=$1 [L,QSA]
RewriteRule ^admin/products/?$ admin/products.html [L,QSA]
RewriteRule ^admin/orders/?$ admin/orders.html [L,QSA]
RewriteRule ^admin/categories/?$ admin/categories.html [L,QSA]
RewriteRule ^admin/coupons/?$ admin/coupons.html [L,QSA]
RewriteRule ^admin/reviews/?$ admin/reviews.html [L,QSA]
RewriteRule ^admin/customers/?$ admin/customers.html [L,QSA]
RewriteRule ^admin/notifications/?$ admin/notifications.html [L,QSA]
RewriteRule ^admin/?$ admin/index.html [L,QSA]
RewriteRule ^contact/?$ contact.html [L,QSA]
RewriteRule ^about/?$ about.html [L,QSA]

# Error 404 Page
ErrorDocument 404 /404.html

# 3. Clean Extensionless URLs (e.g. /shop loads shop.html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# 4. Browser Caching for Fast Performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 5. Enable GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
