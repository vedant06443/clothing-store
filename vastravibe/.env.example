# Database
# Use SQLite for local dev (default), PostgreSQL for production
DATABASE_URL=sqlite:///./vastravibe.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/vastravibe

# Security
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Razorpay (get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (get from https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App Settings
APP_NAME=VastraVibe
DEBUG=True
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Admin
ADMIN_EMAIL=admin@vastravibe.com
ADMIN_PASSWORD=Admin@12345
