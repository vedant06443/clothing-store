# Database
# Local dev: sqlite:///./vastravibe.db
# cPanel MariaDB/MySQL: mysql+pymysql://<db_user>:<db_pass>@localhost/<db_name>?charset=utf8mb4
# PostgreSQL: postgresql://<user>:<password>@localhost:5432/<dbname>
DATABASE_URL=sqlite:///./vastravibe.db

# Security
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Razorpay Payment Gateway (Get from https://dashboard.razorpay.com)
# Test Mode: rzp_test_xxxxxxxxxxxx | Live Mode: rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere
# Webhook Secret configured in Razorpay Dashboard -> Account & Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# Cloudinary (get from https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App Settings
APP_NAME=VastraVibe
DEBUG=True
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Admin
ADMIN_EMAIL=admin@vastravibe.com
ADMIN_PASSWORD=Admin@12345
